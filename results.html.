/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(value){

return String(
value ?? ""
)
.replace(
/[&<>"']/g,
char =>
({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"
}[char])
);

}


