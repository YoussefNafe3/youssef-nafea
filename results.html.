<script>

/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
"https://nhdowqzecpwmkunczodl.supabase.co";

const SUPABASE_ANON_KEY =
"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5oZG93cXplY3B3bWt1bmN6b2RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2MDAyNTUsImV4cCI6MjA5NjE3NjI1NX0.Tdfx0e610t059HG1QZVtsqO_UIppi8Axd02fU6jqqTo";


const client =
supabase.createClient(
SUPABASE_URL,
SUPABASE_ANON_KEY
);


/* =========================================================
   SESSION
========================================================= */

const sessionId =
localStorage.getItem(
"platform_session_id"
);

const user =
JSON.parse(
localStorage.getItem("user") || "null"
);


if(!user || !sessionId){

window.location.replace(
"login.html"
);

throw new Error(
"NO_SESSION"
);

}


/* =========================================================
   USER
========================================================= */

const studentId =
user.id;


document.getElementById(
"welcomeName"
).textContent =
"👋 " +
(
user.full_name ||
user.name ||
"الطالب"
);


/* =========================================================
   THEME
========================================================= */

const themeBtn =
document.getElementById("themeBtn");


if(
localStorage.getItem("platform-theme")
===
"dark"
){

document.body.classList.add("dark");

themeBtn.textContent="☀️";

}


themeBtn.onclick=()=>{

document.body.classList.toggle("dark");

const dark =
document.body.classList.contains("dark");

localStorage.setItem(
"platform-theme",
dark ? "dark" : "light"
);

themeBtn.textContent =
dark ? "☀️" : "🌙";

};


/* =========================================================
   HELPERS
========================================================= */

function percentage(score,total){

if(!total || total <= 0)
return 0;

return Math.round(
(Number(score) /
Number(total)) * 100
);

}


function statusInfo(percent){

if(percent >= 85){

return {

className:"excellent",

badge:"ممتاز",

badgeClass:"good"

};

}

if(percent >= 70){

return {

className:"warning",

badge:"جيد جدًا",

badgeClass:"mid"

};

}

return {

className:"warning",

badge:"يحتاج مراجعة",

badgeClass:"bad"

};

}


function formatDate(date){

if(!date)
return "-";

return new Intl.DateTimeFormat(
"ar-EG",
{
day:"numeric",
month:"long",
year:"numeric"
}
).format(
new Date(date)
);

}


/* =========================================================
   EXAM RESULTS
========================================================= */

let examData=[];


async function loadExamResults(){

const container =
document.getElementById(
"examResults"
);


const {
data,
error
} =
await client
.from("exam_results")
.select("*")
.eq("student_id",studentId)
.order(
"exam_date",
{
ascending:false
}
);


if(error){

console.error(error);

container.innerHTML=`

<div class="empty">

<div class="empty-icon">
⚠️
</div>

<strong>
تعذر تحميل نتائج الامتحانات
</strong>

<span>
حدث خطأ أثناء الاتصال بقاعدة البيانات.
</span>

</div>

`;

return;

}


examData=data || [];


renderExams(
examData
);

updateStatistics();

}


function renderExams(data){

const container =
document.getElementById(
"examResults"
);


if(!data.length){

container.innerHTML=`

<div class="empty">

<div class="empty-icon">
📚
</div>

<strong>
لا توجد نتائج امتحانات حتى الآن
</strong>

<span>
ستظهر نتائجك هنا بمجرد إضافة أول نتيجة.
</span>

</div>

`;

return;

}


container.innerHTML =
data.map(result=>{

const percent =
percentage(
result.score,
result.total
);


const status =
statusInfo(percent);


return `

<article
class="result ${status.className} fade"
data-percent="${percent}"
>

<div class="result-head">

<div>

<div class="result-title">
${escapeHTML(result.title)}
</div>

<div class="result-subtitle">
${escapeHTML(result.subject || "أحياء")}
</div>

</div>

<span
class="status ${status.badgeClass}"
>
${status.badge}
</span>

</div>


<div class="score-row">

<div class="score">

<strong>
${result.score}
</strong>

<span>
/
${result.total}
</span>

</div>

<div class="percent">
${percent}%
</div>

</div>


<div class="progress">

<div
class="progress-bar"
data-width="${percent}%"
>
</div>

</div>


<div class="result-footer">

<span>
📅
${formatDate(result.exam_date)}
</span>

<span>
${
result.duration_minutes
?
"⏱ " +
result.duration_minutes +
" دقيقة"
