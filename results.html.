function updateStatistics(){

document.getElementById(
"examCount"
).textContent =
examData.length;


document.getElementById(
"recitationCount"
).textContent =
recitationData.length;


const percentages =
examData.map(
r =>
percentage(
r.score,
r.total
)
);


if(percentages.length){

const average =
Math.round(
percentages.reduce(
(a,b)=>a+b,
0
) /
percentages.length
);


const highest =
Math.max(...percentages);


document.getElementById(
"examAverage"
).textContent =
average;


document.getElementById(
"highestScore"
).textContent =
highest;

}else{

document.getElementById(
"examAverage"
).textContent=0;

document.getElementById(
"highestScore"
).textContent=0;

}

}


